# ─── Required Environment Variables ───────────────────────────────
# Copy this file to .env and fill in any missing values before running docker-compose

# ─── Application ───────────────────────────────────────────────────
SERVICE_NAME="AI Knowledge Copilot"
VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# ─── JWT Authentication ─────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-before-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── PostgreSQL Database ────────────────────────────────────────────
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_pass
POSTGRES_DB=copilot_db
# (docker-compose builds this from the above automatically)
# DATABASE_URL=postgresql://copilot:copilot_pass@postgres:5432/copilot_db

# ─── Redis / Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Hugging Face Online Embeddings ─────────────────────────────────
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# ─── AI Model Config (optional) ─────────────────────────────────────
embeding_model_name=sentence-transformers/all-MiniLM-L6-v2
chunk_size=1000
chunk_overlap=200
